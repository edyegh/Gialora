@* Gialora.Client/Pages/Plans.razor *@
@page "/plans"
@attribute [Authorize]
@using Gialora.Client.Services
@using Gialora.Shared.Enums
@inject PlannerApi Planner

<PageTitle>@L["Plans.Title"] — Gialora</PageTitle>

<section class="section container-wide">
    <div class="page-header row-between">
        <div>
            <p class="eyebrow">@L["Plans.Eyebrow"]</p>
            <h1 style="margin:0;">@L["Plans.Heading"]</h1>
        </div>
        <a class="btn btn-primary" href="weekly">@L["Plans.PlanNewWeek"]</a>
    </div>

    <ErrorAlert Message="@error" />

    @if (loading)
    {
        <Loading />
    }
    else if (plans.Count == 0)
    {
        <EmptyState Icon="🗓️" Title="@L["Plans.EmptyTitle"]"
                    Description="@L["Plans.EmptyDescription"]">
            <a class="btn btn-primary" href="weekly">@L["Common.PlanMyWeek"]</a>
        </EmptyState>
    }
    else
    {
        <div class="grid">
            @foreach (var plan in plans)
            {
                <a class="card-g card-link" href="plans/@plan.Id">
                    <div class="card-g-body">
                        <p class="eyebrow mb-1">@L.Enum(plan.PlanType) · @L.Enum(plan.Status)</p>
                        <h3 class="recipe-title">@plan.Name</h3>

                        <div class="meta-row mb-2">
                            <span>@L["Plans.Days", plan.Days.Count]</span>
                            <span>@L["Plans.Meals", plan.Days.Sum(d => d.Entries.Count)]</span>
                            <span>🍽 @plan.ServingsPerMeal</span>
                        </div>

                        <div class="cluster">
                            @if (plan.ShoppingListId is not null)
                            {
                                <span class="pill pill-olive">🛒 @L["Plans.ShoppingListReady"]</span>
                            }
                            @if (plan.Status == MealPlanStatus.Accepted)
                            {
                                <span class="pill pill-sea">@L.Enum(MealPlanStatus.Accepted)</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

@code {
    private List<MealPlanDto> plans = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            plans = await Planner.GetPlansAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
