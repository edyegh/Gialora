@* Gialora.Client/Pages/ShoppingListView.razor
   "App automatically creates a shopping list... User checks off ingredients
   while shopping" (app structure §1)։ Խմբավորված է ըստ խանութի բաժնի, ոչ ըստ ռեցեպտի։ *@
@page "/shopping-lists/{ListId:guid}"
@attribute [Authorize]
@using Gialora.Client.Services
@using Gialora.Shared.Enums
@inject PlannerApi Planner
@inject NavigationManager Navigation

<PageTitle>@(list?.Name ?? "Shopping list") — Gialora</PageTitle>

<section class="section container-narrow">
    @if (loading)
    {
        <Loading Message="Loading your list..." />
    }
    else if (list is null)
    {
        <EmptyState Icon="🛒" Title="Shopping list not found">
            <a class="btn btn-primary" href="shopping-lists">All lists</a>
        </EmptyState>
    }
    else
    {
        <div class="page-header">
            <p class="eyebrow">Smart shopping list</p>
            <h1 style="margin:0 0 .75rem;">@list.Name</h1>

            <div class="row-between">
                <span class="small-muted">@list.CheckedItems of @list.TotalItems picked up</span>
                @if (list.MealPlanId is { } planId)
                {
                    <a class="btn btn-outline-g btn-sm" href="plans/@planId">Back to plan</a>
                }
            </div>

            <div class="progress-slim mt-2">
                <div style="width:@(ProgressPercent)%"></div>
            </div>
        </div>

        <ErrorAlert Message="@error" />

        @if (list.TotalItems == 0)
        {
            <EmptyState Icon="🛒" Title="This list is empty"
                        Description="Regenerate it from the meal plan, or add something by hand below." />
        }

        @foreach (var group in list.Groups)
        {
            <div class="shop-group">
                <div class="shop-group-head">@group.CategoryName</div>

                @foreach (var item in group.Items)
                {
                    <div class="shop-item @(item.IsChecked ? "is-checked" : null)">
                        <input type="checkbox" checked="@item.IsChecked"
                               id="@($"item-{item.Id}")"
                               @onchange="e => ToggleItem(item, (bool)(e.Value ?? false))" />

                        <label class="flex-grow-1" for="@($"item-{item.Id}")" style="cursor:pointer;">
                            <span class="shop-item-name">@item.DisplayName</span>
                            <span class="shop-item-qty ms-2">@item.QuantityDisplay</span>

                            @if (item.IsPantryStaple)
                            {
                                <span class="pill pill-outline ms-2">check cupboard</span>
                            }
                            @if (item.IsOptional)
                            {
                                <span class="pill pill-outline ms-2">optional</span>
                            }

                            @* Consolidation-ի հետքը՝ user-ը տեսնում է, թե ինչու է
                               1.7 կգ հավ, և որ ուտեստներից է այն գումարվել *@
                            @if (item.SourceRecipes.Count > 0)
                            {
                                <span class="d-block small-muted">for @string.Join(", ", item.SourceRecipes)</span>
                            }
                        </label>

                        <button class="btn btn-danger-soft btn-sm" title="Remove"
                                @onclick="() => RemoveItem(item.Id)" disabled="@busy">×</button>
                    </div>
                }
            </div>
        }

        <div class="card-g mt-4">
            <div class="card-g-body">
                <p class="eyebrow mb-2">Add something else</p>
                <div class="cluster">
                    <input class="form-control" style="max-width:16rem;" placeholder="e.g. kitchen roll"
                           @bind="newItemName" @bind:event="oninput" @onkeydown="OnNewItemKeyDown" />
                    <input class="form-control" style="max-width:6rem;" type="number" min="1" step="1"
                           @bind="newItemQuantity" />
                    <button class="btn btn-primary" @onclick="AddItem"
                            disabled="@(busy || string.IsNullOrWhiteSpace(newItemName))">Add</button>
                </div>
                <p class="form-text mt-2">
                    Items you add by hand stay on the list even when you regenerate it from the plan.
                </p>
            </div>
        </div>

        <div class="mt-3 cluster">
            <button class="btn btn-outline-g btn-sm" @onclick="ClearChecked"
                    disabled="@(busy || list.CheckedItems == 0)">
                Clear @list.CheckedItems picked-up item(s)
            </button>
            <button class="btn btn-danger-soft btn-sm" @onclick="DeleteList" disabled="@busy">Delete list</button>
        </div>
    }
</section>

@code {
    [Parameter] public Guid ListId { get; set; }

    private ShoppingListDto? list;
    private bool loading = true;
    private bool busy;
    private string? error;

    private string newItemName = string.Empty;
    private int newItemQuantity = 1;

    private int ProgressPercent =>
        list is null || list.TotalItems == 0 ? 0 : (int)Math.Round(100.0 * list.CheckedItems / list.TotalItems);

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        await Run(async () => list = await Planner.GetShoppingListAsync(ListId));
        loading = false;
    }

    private async Task ToggleItem(ShoppingListItemDto item, bool isChecked)
    {
        // Optimistic update — խանութում կանգնած մարդը չպիտի սպասի ամեն նշումից հետո
        // ամբողջ ցանկի վերաբեռնման։ Սխալի դեպքում հետ ենք գլորում։
        var previous = item.IsChecked;
        item.IsChecked = isChecked;
        error = null;

        try
        {
            await Planner.SetItemCheckedAsync(ListId, item.Id, isChecked);
        }
        catch (ApiException ex)
        {
            item.IsChecked = previous;
            error = ex.Message;
        }
    }

    private async Task OnNewItemKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newItemName))
            await AddItem();
    }

    private Task AddItem() => Run(async () =>
    {
        await Planner.AddShoppingItemAsync(ListId, new ShoppingListItemCreateDto
        {
            DisplayName = newItemName.Trim(),
            Quantity = Math.Max(1, newItemQuantity),
            Unit = UnitOfMeasure.Piece,
            Category = IngredientCategory.Other
        });

        newItemName = string.Empty;
        newItemQuantity = 1;
        list = await Planner.GetShoppingListAsync(ListId);
    });

    private Task RemoveItem(Guid itemId) => Run(async () =>
    {
        await Planner.RemoveShoppingItemAsync(ListId, itemId);
        list = await Planner.GetShoppingListAsync(ListId);
    });

    private Task ClearChecked() => Run(async () => list = await Planner.ClearCheckedAsync(ListId));

    private Task DeleteList() => Run(async () =>
    {
        await Planner.DeleteShoppingListAsync(ListId);
        Navigation.NavigateTo("shopping-lists");
    });

    private async Task Run(Func<Task> action)
    {
        busy = true;
        error = null;

        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
