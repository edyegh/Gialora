@* Gialora.Client/Pages/Home.razor
   App structure §2-ի product flow-ը՝ "PURE MEDITERRANEAN GOODNESS" →
   "WHAT DO YOU NEED TODAY?" → DAILY / WEEKLY / BATCH & FREEZE։
   Էջը հանրային է — չգրանցված այցելուն նույնպես պիտի հասկանա, թե ինչ է առաջարկվում։ *@
@page "/"
@using Gialora.Client.Services
@inject PlannerApi Planner

<PageTitle>@L["Home.Title"]</PageTitle>

<section class="section container-wide">
    <div class="page-header" style="text-align:center; max-width:46rem; margin-inline:auto;">
        <p class="eyebrow">@L["Home.Eyebrow"]</p>
        <h1>@L["Home.Heading"]</h1>
        <p class="lede" style="margin-inline:auto;">@L["Home.Lede"]</p>
    </div>

    <div class="grid-3">
        <a class="route-card" href="daily">
            <span class="route-icon" aria-hidden="true">🍅</span>
            <h3>@L["Nav.Daily"]</h3>
            <p>@L["Home.DailyText"]</p>
            <span class="route-go">@L["Home.DailyGo"] →</span>
        </a>

        <a class="route-card" href="weekly">
            <span class="route-icon" aria-hidden="true">🗓️</span>
            <h3>@L["Nav.Weekly"]</h3>
            <p>@L["Home.WeeklyText"]</p>
            <span class="route-go">@L["Common.PlanMyWeek"] →</span>
        </a>

        <a class="route-card" href="batch">
            <span class="route-icon" aria-hidden="true">❄️</span>
            <h3>@L["Nav.Batch"]</h3>
            <p>@L["Home.BatchText"]</p>
            <span class="route-go">@L["Home.BatchGo"] →</span>
        </a>
    </div>
</section>

<AuthorizeView>
    <Authorized>
        <section class="section-tight container-wide">
            @if (loading)
            {
                <Loading Message="@L["Home.CheckingWeek"]" />
            }
            else if (currentPlan is not null)
            {
                <div class="card-g">
                    <div class="card-g-body">
                        <div class="row-between mb-3">
                            <div>
                                <p class="eyebrow mb-1">@L["Home.CurrentPlan"]</p>
                                <h2 style="margin:0;">@currentPlan.Name</h2>
                            </div>
                            <a class="btn btn-primary" href="plans/@currentPlan.Id">@L["Home.OpenPlan"]</a>
                        </div>

                        <div class="cluster">
                            @foreach (var entry in currentPlan.Days.SelectMany(d => d.Entries).Take(6))
                            {
                                <span class="pill pill-olive">@entry.Recipe.Title</span>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <EmptyState Icon="🗓️"
                            Title="@L["Home.NoPlanTitle"]"
                            Description="@L["Home.NoPlanDescription"]">
                    <a class="btn btn-primary" href="family">@L["Common.SetUpMyFamily"]</a>
                </EmptyState>
            }
        </section>
    </Authorized>

    <NotAuthorized>
        <section class="section-tight container-wide">
            <div class="card-g">
                <div class="card-g-body row-between">
                    <div>
                        <h2 style="margin:0 0 .25rem;">@L["Home.CookingForFamily"]</h2>
                        <p class="small-muted" style="margin:0;">@L["Home.CookingForFamilyText"]</p>
                    </div>
                    <div class="cluster">
                        <a class="btn btn-primary" href="register">@L["Home.CreateAnAccount"]</a>
                        <a class="btn btn-outline-g" href="recipes">@L["Common.BrowseRecipes"]</a>
                    </div>
                </div>
            </div>
        </section>
    </NotAuthorized>
</AuthorizeView>

@code {
    private MealPlanDto? currentPlan;
    private bool loading = true;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Ընթացիկ պլանը կարդում ենք ՄԻԱՅՆ մուտք գործածի համար — անանուն
        // այցելուի դեպքում սա 401 կտար և կոնսոլում աղմուկ կստեղծեր։
        if (AuthenticationStateTask is null)
        {
            loading = false;
            return;
        }

        var state = await AuthenticationStateTask;
        if (state.User.Identity?.IsAuthenticated != true)
        {
            loading = false;
            return;
        }

        try
        {
            currentPlan = await Planner.GetCurrentPlanAsync();
        }
        catch (ApiException)
        {
            // Home էջը երբեք չպիտի "կոտրվի" — պլանը պարզապես չենք ցույց տալիս
        }
        finally
        {
            loading = false;
        }
    }
}
