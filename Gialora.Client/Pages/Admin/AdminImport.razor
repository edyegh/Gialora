@* Gialora.Client/Pages/Admin/AdminImport.razor
   "Can we create a structured recipe-import template so I can upload recipes in bulk?"
   (app structure §12) — ահա այն։ *@
@page "/admin/import"
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Components.Forms
@using Gialora.Client.Services
@inject AdminApi Admin
@inject IJSRuntime JS

<PageTitle>@L["Nav.Admin"] · @L["Admin.BulkImport"] — Gialora</PageTitle>

<section class="section container-narrow">
    <div class="page-header row-between">
        <div>
            <p class="eyebrow">@L["Nav.Admin"]</p>
            <h1 style="margin:0;">@L["AdminImport.Heading"]</h1>
        </div>
        <a class="btn btn-outline-g btn-sm" href="admin/recipes">← @L["Nav.Recipes"]</a>
    </div>

    <div class="card-g mb-4">
        <div class="card-g-body">
            <h2 class="mb-2">@L["AdminImport.Step1"]</h2>
            <p class="small-muted">@((MarkupString)L["AdminImport.Step1Text"])</p>
            <button class="btn btn-outline-g" @onclick="DownloadTemplate" disabled="@busy">
                @L["AdminImport.DownloadTemplate"]
            </button>
        </div>
    </div>

    <div class="card-g mb-4">
        <div class="card-g-body stack">
            <h2 style="margin:0;">@L["AdminImport.Step2"]</h2>

            <InputFile class="form-control" OnChange="OnFileSelected" accept=".csv,.txt" />

            @if (!string.IsNullOrEmpty(fileName))
            {
                <p class="small-muted" style="margin:0;">
                    @((MarkupString)L["AdminImport.Loaded", fileName, csvContent.Length])
                </p>
            }

            <div>
                <label class="form-label" for="delimiter">@L["AdminImport.ColumnSeparator"]</label>
                <select id="delimiter" class="form-select" style="max-width:12rem;" @bind="delimiter">
                    <option value=",">@L["AdminImport.Comma"]</option>
                    <option value=";">@L["AdminImport.Semicolon"]</option>
                    <option value="&#9;">@L["AdminImport.Tab"]</option>
                </select>
                <p class="form-text">@L["AdminImport.SeparatorHint"]</p>
            </div>

            <div class="cluster">
                <label class="chip-check @(createMissingIngredients ? "is-on" : null)">
                    <input type="checkbox" @bind="createMissingIngredients" />
                    @L["AdminImport.CreateMissingIngredients"]
                </label>
                <label class="chip-check @(publishImmediately ? "is-on" : null)">
                    <input type="checkbox" @bind="publishImmediately" />
                    @L["AdminImport.PublishImmediately"]
                </label>
                <label class="chip-check @(overwriteExisting ? "is-on" : null)">
                    <input type="checkbox" @bind="overwriteExisting" />
                    @L["AdminImport.OverwriteExisting"]
                </label>
            </div>

            <div>
                <button class="btn btn-primary" @onclick="Import"
                        disabled="@(busy || string.IsNullOrWhiteSpace(csvContent))">
                    @(busy ? L["AdminImport.Importing"] : L["AdminImport.ImportRecipes"])
                </button>
            </div>
        </div>
    </div>

    <ErrorAlert Message="@error" />

    @if (result is not null)
    {
        <div class="card-g">
            <div class="card-g-body">
                <h2 class="mb-3">@L["AdminImport.Result"]</h2>

                <div class="cluster mb-3">
                    <span class="pill pill-olive">@L["AdminImport.Created", result.RecipesCreated]</span>
                    <span class="pill pill-sea">@L["AdminImport.Updated", result.RecipesUpdated]</span>
                    <span class="pill pill-outline">@L["AdminImport.Skipped", result.RecipesSkipped]</span>
                    <span class="pill pill-outline">@L["AdminImport.NewIngredients", result.IngredientsCreated]</span>
                    <span class="pill pill-outline">@L["AdminImport.NewTags", result.TagsCreated]</span>
                </div>

                @* Մասնակի հաջողությունը նորմալ արդյունք է — մի վատ տողը չի տապալում
                   ամբողջ ֆայլը, ուստի ցույց ենք տալիս և՛ եղածը, և՛ ձախողվածը *@
                @if (result.Errors.Count > 0)
                {
                    <div class="alert alert-danger">
                        <strong>@L["AdminImport.FailedCount", result.Errors.Count]</strong>
                        <ul class="mb-0 mt-2 ps-3">
                            @foreach (var message in result.Errors) { <li>@message</li> }
                        </ul>
                    </div>
                }

                @if (result.Warnings.Count > 0)
                {
                    <div class="alert alert-warning">
                        <strong>@L["AdminImport.Warnings"]</strong>
                        <ul class="mb-0 mt-2 ps-3">
                            @foreach (var message in result.Warnings) { <li>@message</li> }
                        </ul>
                    </div>
                }

                @if (result.Success && result.RecipesCreated + result.RecipesUpdated > 0)
                {
                    <div class="alert alert-success mb-0">
                        @L["AdminImport.AllClean"] <a href="admin/recipes">@L["AdminImport.ReviewRecipes"] →</a>
                    </div>
                }
            </div>
        </div>
    }
</section>

@code {
    private const long MaxFileBytes = 5 * 1024 * 1024;

    private string csvContent = string.Empty;
    private string fileName = string.Empty;
    private string delimiter = ",";
    private bool createMissingIngredients = true;
    private bool publishImmediately;
    private bool overwriteExisting;

    private RecipeImportResultDto? result;
    private bool busy;
    private string? error;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        error = null;
        result = null;

        var file = e.File;

        if (file is null)
            return;

        if (file.Size > MaxFileBytes)
        {
            error = L["AdminImport.TooLarge"];
            return;
        }

        try
        {
            // OpenReadStream-ի լռելյայն սահմանը 512 KB է — ռեցեպտների ֆայլը
            // հանգիստ կարող է դրանից մեծ լինել, ուստի բացահայտ բարձրացնում ենք։
            using var stream = file.OpenReadStream(MaxFileBytes);
            using var reader = new StreamReader(stream);

            csvContent = await reader.ReadToEndAsync();
            fileName = file.Name;
        }
        catch (Exception)
        {
            error = L["AdminImport.CouldNotRead"];
            csvContent = string.Empty;
            fileName = string.Empty;
        }
    }

    private async Task Import()
    {
        busy = true;
        error = null;
        result = null;

        try
        {
            result = await Admin.ImportRecipesAsync(new RecipeImportRequestDto
            {
                CsvContent = csvContent,
                Delimiter = string.IsNullOrEmpty(delimiter) ? ',' : delimiter[0],
                CreateMissingIngredients = createMissingIngredients,
                PublishImmediately = publishImmediately,
                OverwriteExisting = overwriteExisting
            });
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task DownloadTemplate()
    {
        busy = true;
        error = null;

        try
        {
            var csv = await Admin.GetImportTemplateAsync();
            await JS.InvokeVoidAsync("gialoraDownload", "gialora-recipe-template.csv", "text/csv", csv);
        }
        catch (Exception)
        {
            error = L["AdminImport.CouldNotDownload"];
        }
        finally
        {
            busy = false;
        }
    }
}
