@* Gialora.Client/Pages/Admin/AdminBlog.razor — "edit blog posts" (app structure §11) *@
@page "/admin/blog"
@page "/admin/blog/{PostId:guid}"
@attribute [Authorize(Roles = "Admin")]
@using Gialora.Client.Services
@inject AdminApi Admin
@inject NavigationManager Navigation

<PageTitle>@L["Nav.Admin"] · @L["Nav.Blog"] — Gialora</PageTitle>

<section class="section container-narrow">
    <div class="page-header row-between">
        <div>
            <p class="eyebrow">@L["Nav.Admin"]</p>
            <h1 style="margin:0;">@L["Nav.Blog"]</h1>
        </div>
        <a class="btn btn-outline-g btn-sm" href="admin/recipes">← @L["Nav.Recipes"]</a>
    </div>

    <ErrorAlert Message="@error" />

    @if (!string.IsNullOrEmpty(status))
    {
        <div class="alert alert-success" role="status">@status</div>
    }

    <div class="card-g mb-4">
        <div class="card-g-body stack">
            <h2 style="margin:0;">@(PostId is null ? L["AdminBlog.NewPost"] : L["AdminBlog.EditPost"])</h2>

            @* Վերնագիրը, ամփոփումը և տեքստը ամեն լեզվով առանձին են. նկարն ու կարգավիճակը՝ ընդհանուր *@
            <LanguageTabs Active="@activeLanguage" Present="PresentLanguages" Disabled="busy"
                          OnSelect="SelectLanguage" OnRemove="RemoveLanguage" />
            <p class="form-text" style="margin:0;">@L["Translations.Hint"]</p>

            <div>
                <label class="form-label" for="title">@L["Common.Title"]</label>
                <input id="title" class="form-control" @bind="Current.Title" @bind:event="oninput" maxlength="200" />
            </div>

            <div>
                <label class="form-label" for="excerpt">@L["AdminBlog.Excerpt"]</label>
                <input id="excerpt" class="form-control" @bind="Current.Excerpt" maxlength="500" />
            </div>

            <div>
                <label class="form-label" for="cover">@L["AdminBlog.CoverImageUrl"]</label>
                <input id="cover" class="form-control" @bind="draft.CoverImageUrl" maxlength="500" />
            </div>

            <div>
                <label class="form-label" for="content">@L["AdminBlog.Content"]</label>
                <textarea id="content" class="form-control" rows="10" @bind="Current.Content"></textarea>
                <p class="form-text">@L["AdminBlog.ParagraphHint"]</p>
            </div>

            <div class="cluster">
                <label class="chip-check @(draft.IsPublished ? "is-on" : null)">
                    <input type="checkbox" @bind="draft.IsPublished" /> @L["Common.Published"]
                </label>

                <button class="btn btn-primary" @onclick="Save"
                        disabled="@(busy || string.IsNullOrWhiteSpace(Current.Title))">
                    @(PostId is null ? L["AdminBlog.CreatePost"] : L["Common.SaveChanges"])
                </button>

                @if (PostId is not null)
                {
                    <a class="btn btn-outline-g" href="admin/blog">@L["AdminBlog.NewPost"]</a>
                }
            </div>
        </div>
    </div>

    @if (loading)
    {
        <Loading />
    }
    else if (posts.Count > 0)
    {
        <div class="table-wrap">
            <table class="table-g">
                <thead>
                    <tr><th>@L["Common.Title"]</th><th>@L["Common.Status"]</th><th>@L["Common.Published"]</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var post in posts)
                    {
                        <tr>
                            <td>
                                <strong>@post.Title</strong>
                                <MissingLanguages Languages="post.Languages" />
                                <div class="small-muted">/@post.Slug</div>
                            </td>
                            <td>
                                <span class="pill @(post.IsPublished ? "pill-olive" : "pill-warning")">
                                    @(post.IsPublished ? L["Common.Published"] : L["Common.Draft"])
                                </span>
                            </td>
                            <td>@(post.PublishedAtUtc is { } published ? L.ShortDate(published.ToLocalTime()) : "—")</td>
                            <td style="text-align:right; white-space:nowrap;">
                                <a class="btn btn-ghost btn-sm" href="admin/blog/@post.Id">@L["Common.Edit"]</a>
                                <ConfirmButton Label="@L["Common.Delete"]" OnConfirm="() => Delete(post.Id)" Disabled="busy" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    [Parameter] public Guid? PostId { get; set; }

    private BlogPostUpdateDto draft = new();

    // Տեքստերը ամեն լեզվով. draft-ի տեքստային դաշտերը լրացվում են ակտիվ tab-ից save-ի պահին
    private Dictionary<string, BlogPostTextDto> texts = new();
    private Dictionary<string, string> savedTexts = new();
    private string activeLanguage = Localizer.DefaultLanguage;

    private BlogPostTextDto Current =>
        texts.TryGetValue(activeLanguage, out var text) ? text : texts[activeLanguage] = new BlogPostTextDto { Language = activeLanguage };

    private ISet<string> PresentLanguages =>
        texts.Values.Where(t => !IsEmpty(t)).Select(t => t.Language).ToHashSet();
    private List<BlogPostSummaryDto> posts = new();
    private bool loading = true;
    private bool busy;
    private string? error;
    private string? status;

    protected override async Task OnParametersSetAsync()
    {
        error = null;

        try
        {
            posts = await Admin.GetPostsAsync();

            if (PostId is { } id)
            {
                var existing = await Admin.GetPostAsync(id);

                draft = existing is null
                    ? new BlogPostUpdateDto()
                    : new BlogPostUpdateDto
                    {
                        CoverImageUrl = existing.CoverImageUrl,
                        IsPublished = existing.IsPublished
                    };

                texts = existing is null
                    ? new()
                    : (await Admin.GetPostTranslationsAsync(id)).ToDictionary(t => t.Language);
                RememberSaved();
                activeLanguage = existing?.ContentLanguage ?? L.Language;
            }
            else
            {
                // /admin/blog-ի վրա վերադառնալիս ձևը պիտի մաքուր լինի, ոչ թե
                // պահի նախորդ խմբագրած գրառումը
                draft = new BlogPostUpdateDto();
                texts = new();
                savedTexts = new();
                activeLanguage = L.Language;
            }
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Save()
    {
        busy = true;
        error = null;
        status = null;

        try
        {
            // Ընդհանուր դաշտերը + ակտիվ լեզվի տեքստը՝ մեկ create/update-ով
            draft.Language = activeLanguage;
            draft.Title = Current.Title;
            draft.Excerpt = Current.Excerpt;
            draft.Content = Current.Content;

            if (PostId is { } id)
            {
                await Admin.UpdatePostAsync(id, draft);

                // Մյուս լեզուների փոփոխությունները՝ ամեն մեկն իր PUT-ով
                foreach (var text in ChangedOtherTexts().ToList())
                    await Admin.SavePostTranslationAsync(id, text);

                RememberSaved();
                status = L["AdminBlog.StatusSaved"];
                posts = await Admin.GetPostsAsync();
            }
            else
            {
                var newId = await Admin.CreatePostAsync(draft);
                foreach (var text in ChangedOtherTexts().ToList())
                    await Admin.SavePostTranslationAsync(newId, text);

                Navigation.NavigateTo($"admin/blog/{newId}");
            }
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static bool IsEmpty(BlogPostTextDto text) =>
        string.IsNullOrWhiteSpace(text.Title) && string.IsNullOrWhiteSpace(text.Excerpt) && string.IsNullOrWhiteSpace(text.Content);

    private static string Snapshot(BlogPostTextDto text) => $"{text.Title}\u0001{text.Excerpt}\u0001{text.Content}";

    private void RememberSaved() => savedTexts = texts.ToDictionary(t => t.Key, t => Snapshot(t.Value));

    private IEnumerable<BlogPostTextDto> ChangedOtherTexts() =>
        texts.Values.Where(t => t.Language != activeLanguage && !IsEmpty(t)
            && (!savedTexts.TryGetValue(t.Language, out var saved) || saved != Snapshot(t)));

    private void SelectLanguage(string language) => activeLanguage = language;

    private async Task RemoveLanguage(string language)
    {
        if (PostId is not { } id)
        {
            texts.Remove(language);
            activeLanguage = texts.Keys.FirstOrDefault() ?? L.Language;
            return;
        }

        busy = true;
        error = null;
        status = null;

        try
        {
            await Admin.DeletePostTranslationAsync(id, language);
            texts.Remove(language);
            RememberSaved();
            activeLanguage = texts.Keys.OrderBy(k => k == Localizer.DefaultLanguage ? 0 : 1).First();
            posts = await Admin.GetPostsAsync();
            status = L["Translations.Removed", Localizer.Languages.First(l => l.Code == language).NativeName];
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete(Guid id)
    {
        busy = true;
        error = null;

        try
        {
            await Admin.DeletePostAsync(id);
            posts = await Admin.GetPostsAsync();

            if (PostId == id)
                Navigation.NavigateTo("admin/blog");
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
