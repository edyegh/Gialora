@* Gialora.Client/Pages/Admin/AdminIngredients.razor
   Բաղադրիչների կատալոգը՝ shopping list-ի consolidation-ի հիմքը (app structure §3, §11)։ *@
@page "/admin/ingredients"
@attribute [Authorize(Roles = "Admin")]
@using Gialora.Client.Services
@using Gialora.Shared.Enums
@inject AdminApi Admin
@inject RecipeApi RecipeCatalog

<PageTitle>@L["Nav.Admin"] · @L["Admin.Ingredients"] — Gialora</PageTitle>

<section class="section container-wide">
    <div class="page-header row-between">
        <div>
            <p class="eyebrow">@L["Nav.Admin"]</p>
            <h1 style="margin:0;">@L["Admin.Ingredients"]</h1>
            <p class="small-muted" style="margin:.35rem 0 0;">@L["AdminIngredients.Lede"]</p>
        </div>
        <a class="btn btn-outline-g" href="admin/recipes">← @L["Nav.Recipes"]</a>
    </div>

    <ErrorAlert Message="@error" />

    <div class="card-g mb-4">
        <div class="card-g-body">
            <p class="eyebrow mb-2">@L["AdminIngredients.AddIngredient"]</p>
            <div class="cluster">
                <input class="form-control" style="max-width:14rem;" placeholder="@L["Common.Name"]" @bind="draft.Name" />

                <select class="form-select" style="max-width:12rem;" @bind="draft.Category">
                    @foreach (var c in Enum.GetValues<IngredientCategory>()) { <option value="@c">@L.Enum(c)</option> }
                </select>

                <select class="form-select" style="max-width:10rem;" @bind="draft.DefaultUnit">
                    @foreach (var u in Enum.GetValues<UnitOfMeasure>()) { <option value="@u">@L.Enum(u)</option> }
                </select>

                <button class="btn btn-primary" @onclick="Create"
                        disabled="@(busy || string.IsNullOrWhiteSpace(draft.Name))">@L["Common.Add"]</button>
            </div>

            <p class="small-muted mt-3 mb-1">@L["AdminIngredients.ContainsAllergens"]</p>
            <AllergenPicker Selected="draft.Allergens" Disabled="busy" />

            <div class="cluster mt-2">
                <label class="chip-check @(draft.IsPantryStaple ? "is-on" : null)">
                    <input type="checkbox" @bind="draft.IsPantryStaple" /> @L["AdminIngredients.PantryStaple"]
                </label>
            </div>
            <p class="form-text mb-0">@L["AdminIngredients.AllergenHint"]</p>
        </div>
    </div>

    @if (UnreviewedCount > 0)
    {
        @* Չստուգված բաղադրիչով ռեցեպտները ալերգիա ունեցող ընտանիքներին չեն առաջարկվում *@
        <div class="alert alert-warning">
            @L["AdminIngredients.UnreviewedWarning", UnreviewedCount]
        </div>
    }

    <div class="cluster mb-3">
        <input class="form-control" style="max-width:20rem;" placeholder="@L["Common.FilterPlaceholder"]"
               @bind="search" @bind:event="oninput" />
        <label class="chip-check @(onlyUnreviewed ? "is-on" : null)">
            <input type="checkbox" @bind="onlyUnreviewed" /> @L["AdminIngredients.NeedsReviewFilter", UnreviewedCount]
        </label>
    </div>

    @if (loading)
    {
        <Loading />
    }
    else
    {
        <div class="table-wrap">
            <table class="table-g">
                <thead>
                    <tr>
                        <th>@L["Common.Name"]</th><th>@L["AdminIngredients.ColCategory"]</th><th>@L["AdminIngredients.ColDefaultUnit"]</th>
                        <th>@L["AdminIngredients.ColAllergens"]</th><th>@L["AdminIngredients.ColUsedIn"]</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ingredient in Filtered)
                    {
                        <tr>
                            <td>
                                <strong>@ingredient.Name</strong>
                                @if (ingredient.IsPantryStaple)
                                {
                                    <span class="pill pill-outline ms-2">@L["AdminIngredients.Staple"]</span>
                                }
                            </td>
                            <td>@L.Enum(ingredient.Category)</td>
                            <td>@L.Enum(ingredient.DefaultUnit)</td>
                            <td>
                                <div class="cluster">
                                    @if (!ingredient.AllergensReviewed)
                                    {
                                        <span class="pill pill-outline">⚠ @L["AdminIngredients.NeedsReview"]</span>
                                    }
                                    @foreach (var allergen in ingredient.Allergens)
                                    {
                                        <span class="pill pill-terracotta">@L.Enum(allergen)</span>
                                    }
                                    @if (ingredient.AllergensReviewed && ingredient.Allergens.Count == 0)
                                    {
                                        <span class="small-muted">@L["AdminIngredients.NoAllergens"]</span>
                                    }
                                </div>
                            </td>
                            <td>@L["AdminIngredients.RecipeCount", ingredient.UsedInRecipeCount]</td>
                            <td style="text-align:right; white-space:nowrap;">
                                <button class="btn btn-outline-g btn-sm" @onclick="() => StartEdit(ingredient)"
                                        disabled="@busy">@L["AdminIngredients.ReviewAllergens"]</button>
                                @* Օգտագործվողը ջնջելը server-ը մերժում է 409-ով —
                                   կոճակը նախապես անջատում ենք, որ սխալ չառաջանա *@
                                <button class="btn btn-danger-soft btn-sm"
                                        @onclick="() => Delete(ingredient.Id)"
                                        disabled="@(busy || ingredient.UsedInRecipeCount > 0)"
                                        title="@(ingredient.UsedInRecipeCount > 0 ? L["AdminIngredients.InUse"] : L["Common.Delete"])">
                                    @L["Common.Delete"]
                                </button>
                            </td>
                        </tr>

                        @if (editingId == ingredient.Id)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="stack">
                                        <p class="eyebrow" style="margin:0;">@L["AdminIngredients.AllergensOf", ingredient.Name]</p>
                                        <AllergenPicker Selected="edit.Allergens" Disabled="busy" />
                                        <p class="form-text mb-0">@L["AdminIngredients.SaveMarksReviewed"]</p>
                                        <div class="cluster">
                                            <button class="btn btn-primary btn-sm" @onclick="SaveEdit" disabled="@busy">@L["Common.Save"]</button>
                                            <button class="btn btn-outline-g btn-sm" @onclick="() => editingId = null" disabled="@busy">@L["Common.Cancel"]</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<IngredientDto> ingredients = new();
    private IngredientCreateDto draft = new();
    private string search = string.Empty;
    private bool onlyUnreviewed;

    // Եղած բաղադրիչի ալերգենների վերանայումը (inline տող)
    private Guid? editingId;
    private IngredientUpdateDto edit = new();

    private int UnreviewedCount => ingredients.Count(i => !i.AllergensReviewed);
    private bool loading = true;
    private bool busy;
    private string? error;

    private IEnumerable<IngredientDto> Filtered => ingredients
        .Where(i => !onlyUnreviewed || !i.AllergensReviewed)
        .Where(i => string.IsNullOrWhiteSpace(search) || i.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => Reload();

    private void StartEdit(IngredientDto ingredient)
    {
        editingId = ingredient.Id;

        // PUT-ը փոխարինում է ամբողջը — մնացած դաշտերը պահում ենք ինչպես կան
        edit = new IngredientUpdateDto
        {
            Name = ingredient.Name,
            Category = ingredient.Category,
            DefaultUnit = ingredient.DefaultUnit,
            IsPantryStaple = ingredient.IsPantryStaple,
            Allergens = ingredient.Allergens.ToList()
        };
    }

    private async Task SaveEdit()
    {
        if (editingId is not { } id)
            return;

        busy = true;
        error = null;

        try
        {
            await Admin.UpdateIngredientAsync(id, edit);
            editingId = null;
            await Reload();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Create()
    {
        busy = true;
        error = null;

        try
        {
            await Admin.CreateIngredientAsync(draft);
            draft = new IngredientCreateDto();
            await Reload();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Delete(Guid id)
    {
        busy = true;
        error = null;

        try
        {
            await Admin.DeleteIngredientAsync(id);
            await Reload();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Reload()
    {
        loading = true;

        try
        {
            ingredients = await RecipeCatalog.GetIngredientsAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
