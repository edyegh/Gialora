@* Gialora.Client/Pages/Login.razor *@
@page "/login"
@using Gialora.Client.Services
@inject AccountApi Account
@inject NavigationManager Navigation

<PageTitle>@L["Nav.SignIn"] — Gialora</PageTitle>

<section class="section container-narrow" style="max-width:26rem;">
    <div class="page-header">
        <p class="eyebrow">@L["Login.Eyebrow"]</p>
        <h1 style="margin:0;">@L["Nav.SignIn"]</h1>
    </div>

    <div class="card-g">
        <div class="card-g-body">
            <EditForm Model="@loginDto" OnValidSubmit="HandleLogin" FormName="login">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="email">@L["Common.Email"]</label>
                    <InputText id="email" class="form-control" autocomplete="username"
                               @bind-Value="loginDto.Email" />
                    <ValidationMessage For="@(() => loginDto.Email)" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="password">@L["Common.Password"]</label>
                    <InputText id="password" class="form-control" type="password" autocomplete="current-password"
                               @bind-Value="loginDto.Password" />
                    <ValidationMessage For="@(() => loginDto.Password)" />
                </div>

                <ErrorAlert Message="@errorMessage" />

                <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                    @(isSubmitting ? L["Login.Submitting"] : L["Nav.SignIn"])
                </button>
            </EditForm>

            <p class="mt-3 mb-0 small-muted">
                @L["Login.NoAccount"] <a href="register">@L["Login.CreateOne"]</a>
            </p>
        </div>
    </div>
</section>

@code {
    private LoginDto loginDto = new();
    private string? errorMessage;
    private bool isSubmitting;

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Արդեն մուտք գործածը login էջում գործ չունի
        if (AuthenticationStateTask is null)
            return;

        var state = await AuthenticationStateTask;
        if (state.User.Identity?.IsAuthenticated == true)
            NavigateAfterLogin();
    }

    private async Task HandleLogin()
    {
        if (isSubmitting) return; // կրկնակի submit-ի պաշտպանություն

        isSubmitting = true;
        errorMessage = null;

        try
        {
            await Account.LoginAsync(loginDto);
            NavigateAfterLogin();
        }
        catch (ApiException ex)
        {
            errorMessage = ex.Message;
        }
        catch (HttpRequestException)
        {
            errorMessage = L["Common.ServerUnreachable"];
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void NavigateAfterLogin()
    {
        var target = string.IsNullOrWhiteSpace(ReturnUrl) ? string.Empty : ReturnUrl;

        // Միայն հարաբերական URL-ներ — բացառում ենք open-redirect-ը դեպի ուրիշ site
        if (target.Contains("//") || target.StartsWith('/'))
            target = string.Empty;

        Navigation.NavigateTo(target, replace: true);
    }
}
