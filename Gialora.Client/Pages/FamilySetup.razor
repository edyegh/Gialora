@* Gialora.Client/Pages/FamilySetup.razor
   App structure §1-ի onboarding-ի սիրտը՝ "Adds family members" + "Selects preferences"։
   Այս էջի տվյալն է meal-planning engine-ի ամբողջ մուտքը։ *@
@page "/family"
@page "/family-setup"
@attribute [Authorize]
@using Gialora.Client.Services
@using Gialora.Shared.Enums
@using Gialora.Shared.Goals
@inject PlannerApi Planner

<PageTitle>@L["Nav.MyFamily"] — Gialora</PageTitle>

<section class="section container-narrow">
    <div class="page-header">
        <p class="eyebrow">@L["Family.Eyebrow"]</p>
        <h1 style="margin:0 0 .35rem;">@(family?.Name ?? L["Family.SetupTitle"])</h1>
        <p class="lede">@L["Family.Lede"]</p>
    </div>

    <ErrorAlert Message="@error" Errors="validationErrors" />

    @if (!string.IsNullOrEmpty(status))
    {
        <div class="alert alert-success" role="status">@status</div>
    }

    @if (loading)
    {
        <Loading />
    }
    else if (family is not null)
    {
        @* ------------------------------------------------------ members *@
        <div class="card-g mb-4">
            <div class="card-g-body">
                <h2 class="mb-3">@L["Family.WhoIsEating"]</h2>

                @if (family.Members.Count == 0)
                {
                    <p class="small-muted">@L["Family.NoMembers"]</p>
                }
                else
                {
                    <p class="small-muted mb-2">
                        @((MarkupString)L["Family.EatingWithYou", family.ActiveMemberCount, family.Members.Count])
                        @L["Family.SwitchOffHint"]
                    </p>

                    <div class="table-wrap mb-3">
                        <table class="table-g">
                            <thead>
                                <tr>
                                    <th>@L["Family.ColEating"]</th>
                                    <th>@L["Common.Name"]</th>
                                    <th>@L["Family.ColType"]</th>
                                    <th>@L["Family.ColAge"]</th>
                                    <th>@L["Family.ColNeeds"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in family.Members)
                                {
                                    <tr class="@(member.IsActive ? null : "member-inactive")">
                                        <td>
                                            @* Դիտավորյալ ոչ թե "Remove"-ի կողքին — սա հակադարձելի է, ջնջելը՝ ոչ։ *@
                                            <label class="chip-check @(member.IsActive ? "is-on" : null)"
                                                   title="@(member.IsActive ? L["Family.ActiveTooltipOn"] : L["Family.ActiveTooltipOff"])">
                                                <input type="checkbox" checked="@member.IsActive" disabled="@busy"
                                                       @onchange="e => SetMemberActive(member.Id, (bool)(e.Value ?? false))" />
                                                @L["Family.Active"]
                                            </label>
                                        </td>
                                        <td><strong>@member.Name</strong></td>
                                        <td>@L.Enum(member.MemberType)</td>
                                        <td>@(member.Age is null ? "—" : $"{member.Age}")</td>
                                        <td>
                                            <div class="cluster">
                                                @foreach (var allergy in member.Allergies)
                                                {
                                                    <span class="pill pill-terracotta">⚠ @allergy</span>
                                                }
                                                @foreach (var restriction in member.DietaryRestrictions)
                                                {
                                                    <span class="pill pill-olive">@restriction</span>
                                                }
                                                @foreach (var goal in member.Goals)
                                                {
                                                    <span class="pill pill-outline">@GoalDisplay(goal)</span>
                                                }
                                            </div>
                                        </td>
                                        <td style="text-align:right;">
                                            <button class="btn btn-danger-soft btn-sm"
                                                    @onclick="() => RemoveMember(member.Id)" disabled="@busy">@L["Common.Remove"]</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="stack" style="border-top:1px solid var(--line); padding-top:1rem;">
                    <p class="eyebrow" style="margin:0;">@L["Family.AddMember"]</p>

                    <div class="cluster">
                        <input class="form-control" style="max-width:12rem;" placeholder="@L["Common.Name"]"
                               @bind="newMember.Name" />

                        <select class="form-select" style="max-width:9rem;" @bind="NewMemberType">
                            @foreach (var type in Enum.GetValues<FamilyMemberType>())
                            {
                                <option value="@type">@L.Enum(type)</option>
                            }
                        </select>

                        <input class="form-control" style="max-width:7rem;" type="number" min="0" max="120"
                               placeholder="@L["Family.ColAge"]" @bind="newMember.Age" />

                        <input class="form-control" style="max-width:15rem;"
                               placeholder="@L["Family.AllergiesPlaceholder"]" @bind="newMemberAllergies" />

                        <input class="form-control" style="max-width:15rem;"
                               placeholder="@L["Family.GoalsPlaceholder"]" @bind="newMemberGoals" />

                        <button class="btn btn-primary" @onclick="AddMember"
                                disabled="@(busy || string.IsNullOrWhiteSpace(newMember.Name))">@L["Common.Add"]</button>
                    </div>

                    @* Նպատակները ազատ տեքստ էին, և user-ը չէր իմանում, թե որոնք են
                       իրականում գործում։ Այժմ ճանաչվողները մեկ սեղմումով ավելացվում են։
                       Կոճակը ցույց է տալիս թարգմանությունը, բայց դաշտին ավելացնում է
                       անգլերեն Label-ը — engine-ը հենց դրանով է ճանաչում նպատակը։ *@
                    <div class="cluster">
                        <span class="small-muted">@L["Family.GoalsThatChangePlan"]</span>
                        @foreach (var goal in SupportedGoals)
                        {
                            <button type="button" class="chip-check" @onclick="() => AddGoal(goal.Label)">
                                + @L[$"Goal.{goal.Key}"]
                            </button>
                        }
                    </div>

                    @if (unrecognisedGoals.Count > 0)
                    {
                        <div class="alert alert-warning mb-0">
                            @L["Family.UnrecognisedGoals"]
                            <strong>@string.Join(", ", unrecognisedGoals)</strong>.
                            @L["Family.UnrecognisedGoalsHint"]
                        </div>
                    }

                    <p class="form-text">@L["Family.AllergiesHint"]</p>
                </div>
            </div>
        </div>

        @* -------------------------------------------------- preferences *@
        <div class="card-g">
            <div class="card-g-body stack">
                <h2 style="margin:0;">@L["Family.Preferences"]</h2>

                <div class="cluster">
                    <div>
                        <label class="form-label" for="maxtime">@L["Family.MaxTime"]</label>
                        <select id="maxtime" class="form-select" style="max-width:11rem;"
                                @bind="preferences.MaxCookingTimeMinutes">
                            <option value="20">@L["Family.Minutes", 20]</option>
                            <option value="30">@L["Family.Minutes", 30]</option>
                            <option value="45">@L["Family.Minutes", 45]</option>
                            <option value="60">@L["Family.OneHour"]</option>
                            <option value="90">@L["Family.OneAndHalfHours"]</option>
                            <option value="180">@L["Family.NoRealLimit"]</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="days">@L["Family.CookingDays"]</label>
                        <input id="days" class="form-control" type="number" min="1" max="7"
                               style="max-width:7rem;" @bind="preferences.CookingDaysPerWeek" />
                    </div>

                    <div>
                        <label class="form-label" for="servings">@L["Launcher.ServingsPerMeal"]</label>
                        <input id="servings" class="form-control" type="number" min="1" max="20"
                               style="max-width:7rem;" @bind="preferences.ServingsPerMeal" />
                        <p class="form-text mb-0">@L["Family.ServingsHint"]</p>
                    </div>

                    <div>
                        <label class="form-label" for="budget">@L["Family.Budget"]</label>
                        <select id="budget" class="form-select" style="max-width:10rem;" @bind="preferences.Budget">
                            @foreach (var level in Enum.GetValues<BudgetLevel>())
                            {
                                <option value="@level">@L.Enum(level)</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="form-label" for="diet">@L["Family.HouseholdDiet"]</label>
                        <select id="diet" class="form-select" style="max-width:11rem;" @bind="SelectedDiet">
                            <option value="">@L["Family.NoRestriction"]</option>
                            @foreach (var diet in Enum.GetValues<DietType>())
                            {
                                <option value="@diet">@L.Enum(diet)</option>
                            }
                        </select>
                    </div>
                </div>

                <div>
                    <span class="form-label d-block">@L["Family.ProteinsToAvoid"]</span>
                    <div class="cluster">
                        @foreach (var protein in AvoidableProteins)
                        {
                            var isOn = preferences.ExcludedProteins.Contains(protein);
                            <label class="chip-check @(isOn ? "is-on" : null)">
                                <input type="checkbox" checked="@isOn"
                                       @onchange="e => ToggleProtein(protein, (bool)(e.Value ?? false))" />
                                @L.Enum(protein)
                            </label>
                        }
                    </div>
                    <p class="form-text">@L["Family.ProteinsHint"]</p>
                </div>

                <div>
                    <label class="form-label" for="disliked">@L["Family.Disliked"]</label>
                    <input id="disliked" class="form-control" placeholder="@L["Family.DislikedPlaceholder"]"
                           @bind="dislikedIngredients" />
                    <p class="form-text">@L["Family.DislikedHint"]</p>
                </div>

                <label class="chip-check @(preferences.PreferFreezerFriendly ? "is-on" : null)"
                       style="align-self:flex-start;">
                    <input type="checkbox" @bind="preferences.PreferFreezerFriendly" />
                    @L["Family.PreferFreezer"]
                </label>

                <div class="cluster">
                    <button class="btn btn-primary" @onclick="SavePreferences" disabled="@busy">
                        @L["Family.SavePreferences"]
                    </button>
                    <a class="btn btn-outline-g" href="weekly">@L["Common.PlanMyWeek"] →</a>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private FamilyDto? family;
    private FamilyPreferencesDto preferences = new();

    private FamilyMemberCreateDto newMember = new();
    private string newMemberAllergies = string.Empty;
    private string newMemberGoals = string.Empty;

    // Ցանկը գալիս է Shared-ից, ոչ թե այստեղ պատճենված — էջը չի կարող խոստանալ
    // նպատակ, որ պլանավորիչը չի ճանաչում։
    private static IReadOnlyList<NutritionGoals.NutritionGoal> SupportedGoals => NutritionGoals.All;

    private List<string> unrecognisedGoals = new();
    private string dislikedIngredients = string.Empty;

    private bool loading = true;
    private bool busy;
    private string? error;
    private string? status;
    private Dictionary<string, string[]>? validationErrors;

    // Դիտավորյալ ոչ բոլորը — "None"-ը բացառելը իմաստ չունի
    private static readonly ProteinType[] AvoidableProteins =
    {
        ProteinType.Fish, ProteinType.Seafood, ProteinType.Pork, ProteinType.Beef,
        ProteinType.Lamb, ProteinType.Chicken, ProteinType.Egg, ProteinType.Dairy
    };

    private string NewMemberType
    {
        get => newMember.MemberType.ToString();
        set => newMember.MemberType = Enum.TryParse<FamilyMemberType>(value, out var v) ? v : FamilyMemberType.Adult;
    }

    private string SelectedDiet
    {
        get => preferences.DietPreference?.ToString() ?? string.Empty;
        set => preferences.DietPreference = Enum.TryParse<DietType>(value, out var v) ? v : null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            family = await Planner.GetFamilyAsync();
            preferences = family.Preferences;
            dislikedIngredients = string.Join(", ", preferences.DislikedIngredients);
            RefreshUnrecognisedGoals();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>Պահված նպատակը ճանաչված է՝ ցույց ենք տալիս թարգմանությունը, այլապես՝ ինչպես գրվել է։</summary>
    private string GoalDisplay(string raw)
    {
        var match = NutritionGoals.Resolve(new[] { raw }).FirstOrDefault();
        return match is null ? raw : L[$"Goal.{match.Key}"];
    }

    private void ToggleProtein(ProteinType protein, bool isOn)
    {
        if (isOn)
        {
            if (!preferences.ExcludedProteins.Contains(protein))
                preferences.ExcludedProteins.Add(protein);
        }
        else
        {
            preferences.ExcludedProteins.Remove(protein);
        }
    }

    /// <summary>Ճանաչված նպատակը մեկ սեղմումով ավելացնում ենք տեքստի դաշտին։</summary>
    private void AddGoal(string label)
    {
        var current = SplitList(newMemberGoals);

        if (!current.Contains(label, StringComparer.OrdinalIgnoreCase))
            current.Add(label);

        newMemberGoals = string.Join(", ", current);
        RefreshUnrecognisedGoals();
    }

    private void RefreshUnrecognisedGoals()
    {
        var typed = SplitList(newMemberGoals);
        var saved = family?.Members.SelectMany(m => m.Goals) ?? Enumerable.Empty<string>();

        unrecognisedGoals = NutritionGoals.Unrecognised(typed.Concat(saved));
    }

    private Task AddMember() => Run(async () =>
    {
        newMember.Allergies = SplitList(newMemberAllergies);
        newMember.Goals = SplitList(newMemberGoals);

        await Planner.AddMemberAsync(newMember);

        newMember = new FamilyMemberCreateDto();
        newMemberAllergies = string.Empty;
        newMemberGoals = string.Empty;

        family = await Planner.GetFamilyAsync();
        RefreshUnrecognisedGoals();
        status = L["Family.StatusMemberAdded"];
    });

    private Task RemoveMember(Guid memberId) => Run(async () =>
    {
        await Planner.RemoveMemberAsync(memberId);
        family = await Planner.GetFamilyAsync();
        status = L["Family.StatusMemberRemoved"];
    });

    private Task SetMemberActive(Guid memberId, bool isActive) => Run(async () =>
    {
        var member = await Planner.SetMemberActiveAsync(memberId, isActive);
        family = await Planner.GetFamilyAsync();
        RefreshUnrecognisedGoals();

        status = isActive
            ? L["Family.StatusMemberActive", member.Name]
            : L["Family.StatusMemberInactive", member.Name];
    });

    private Task SavePreferences() => Run(async () =>
    {
        preferences.DislikedIngredients = SplitList(dislikedIngredients);
        preferences = await Planner.SavePreferencesAsync(preferences);
        dislikedIngredients = string.Join(", ", preferences.DislikedIngredients);
        status = L["Family.StatusPreferencesSaved"];
    });

    private static List<string> SplitList(string value) =>
        value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
             .Distinct(StringComparer.OrdinalIgnoreCase)
             .ToList();

    private async Task Run(Func<Task> action)
    {
        busy = true;
        error = null;
        status = null;
        validationErrors = null;

        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
            validationErrors = ex.ValidationErrors;
        }
        finally
        {
            busy = false;
        }
    }
}
