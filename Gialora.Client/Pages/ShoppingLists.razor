@* Gialora.Client/Pages/ShoppingLists.razor *@
@page "/shopping-lists"
@attribute [Authorize]
@using Gialora.Client.Services
@inject PlannerApi Planner

<PageTitle>@L["ShoppingLists.Title"] — Gialora</PageTitle>

<section class="section container-narrow">
    <div class="page-header">
        <p class="eyebrow">@L["ShoppingLists.Eyebrow"]</p>
        <h1 style="margin:0;">@L["ShoppingLists.Heading"]</h1>
    </div>

    <ErrorAlert Message="@error" />

    @if (loading)
    {
        <Loading />
    }
    else if (lists.Count == 0)
    {
        <EmptyState Icon="🛒" Title="@L["ShoppingLists.EmptyTitle"]"
                    Description="@L["ShoppingLists.EmptyDescription"]">
            <a class="btn btn-primary" href="weekly">@L["Common.PlanMyWeek"]</a>
        </EmptyState>
    }
    else
    {
        <div class="stack">
            @foreach (var list in lists)
            {
                <a class="card-g card-link" href="shopping-lists/@list.Id">
                    <div class="card-g-body row-between">
                        <div>
                            <h3 class="recipe-title">@list.Name</h3>
                            <span class="small-muted">
                                @L["ShoppingLists.PickedUp", list.CheckedItems, list.TotalItems] ·
                                @L.DayMonth(list.CreatedAtUtc.ToLocalTime())
                            </span>
                        </div>
                        <span class="pill @(list.CheckedItems == list.TotalItems && list.TotalItems > 0 ? "pill-olive" : "pill-outline")">
                            @(list.TotalItems == 0 ? L["ShoppingLists.StatusEmpty"]
                              : list.CheckedItems == list.TotalItems ? L["ShoppingLists.StatusDone"] : L["ShoppingLists.StatusInProgress"])
                        </span>
                    </div>
                </a>
            }
        </div>
    }
</section>

@code {
    private List<ShoppingListDto> lists = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            lists = await Planner.GetShoppingListsAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
