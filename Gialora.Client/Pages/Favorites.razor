@* Gialora.Client/Pages/Favorites.razor — "Save/favorite recipes" (app structure §9) *@
@page "/favorites"
@attribute [Authorize]
@using Gialora.Client.Services
@inject RecipeApi Recipes

<PageTitle>@L["Favorites.Title"] — Gialora</PageTitle>

<section class="section container-wide">
    <div class="page-header">
        <p class="eyebrow">@L["Nav.Saved"]</p>
        <h1 style="margin:0 0 .35rem;">@L["Favorites.Heading"]</h1>
        <p class="lede">@L["Favorites.Lede"]</p>
    </div>

    <ErrorAlert Message="@error" />

    @if (loading)
    {
        <Loading />
    }
    else if (favorites.Count == 0)
    {
        <EmptyState Icon="★" Title="@L["Favorites.EmptyTitle"]"
                    Description="@L["Favorites.EmptyDescription"]">
            <a class="btn btn-primary" href="recipes">@L["Common.BrowseRecipes"]</a>
        </EmptyState>
    }
    else
    {
        <div class="grid">
            @foreach (var recipe in favorites)
            {
                <RecipeCard Recipe="recipe" />
            }
        </div>
    }
</section>

@code {
    private List<RecipeSummaryDto> favorites = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            favorites = await Recipes.GetFavoritesAsync();
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
