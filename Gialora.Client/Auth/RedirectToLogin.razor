@* Gialora.Client/Auth/RedirectToLogin.razor *@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // Հիշում ենք, թե ուր էր գնում user-ը, որ login-ից հետո վերադարձնենք նույն էջ
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        Navigation.NavigateTo(
            string.IsNullOrEmpty(returnUrl) || returnUrl.StartsWith("login", StringComparison.OrdinalIgnoreCase)
                ? "login"
                : $"login?returnUrl={Uri.EscapeDataString(returnUrl)}",
            replace: true);
    }
}
