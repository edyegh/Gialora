<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Հավելվածը միալեզու է (անգլերեն), իսկ ամսաթվերը ձևաչափվում են
         InvariantCulture-ով։ ICU-ի ամբողջ տվյալների հավաքածուն (≈1.1 ՄԲ)
         browser-ը ոչ մի բանի համար չի օգտագործում, ուստի չենք ուղարկում։ -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- PWA։ publish-ի ժամանակ գեներացվում է wwwroot/service-worker-assets.js-ը՝
         բոլոր ֆայլերի ցանկը integrity hash-երով, որը service-worker.published.js-ը
         կարդում է precache անելու համար։ -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.19" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.19" />

    <!-- System.IdentityModel.Tokens.Jwt-ը ԴԻՏԱՎՈՐՅԱԼ բացակայում է։ Այն browser
         ուղարկում էր ≈5 ՄԲ ավելորդ assembly (System.Private.Xml, System.Data.Common,
         ամբողջ System.Xml ընտանիքը) SAML/XML token-ների համար, որոնք այստեղ պետք չեն։
         Token-ի payload-ը կարդում է Auth/JwtReader.cs-ը; ստորագրությունը ստուգում է API-ն։ -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gialora.Shared\Gialora.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- dev-ում գործում է դատարկ service-worker.js-ը, publish-ում այն փոխարինվում է
         PublishedContent-ով։ Առանց դրա `dotnet run`-ը մատուցեր էր cache-ված հին UI։ -->
    <ServiceWorker Include="wwwroot\service-worker.js"
                   PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- localhost-ի API հասցեն միայն dev-ի համար է — production-ում չենք ուղարկում։ -->
    <Content Update="wwwroot\appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
