@* Gialora.Client/Layout/MainLayout.razor *@
@inherits LocalizedLayoutComponentBase

<div class="page">
    <NavMenu />

    <main class="page-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="container-wide row-between">
            <span>@L["Footer.Tagline"]</span>
            <span class="cluster">
                <NavLink href="recipes">@L["Nav.Recipes"]</NavLink>
                <span aria-hidden="true">·</span>
                <NavLink href="blog">@L["Nav.Blog"]</NavLink>
            </span>
        </div>
    </footer>
</div>
