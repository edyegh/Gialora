@* Gialora.Client/Layout/MainLayout.razor *@
@inherits LocalizedLayoutComponentBase

<div class="page">
    <PwaUpdatePrompt />
    <PwaInstallPrompt />

    <NavMenu />

    <main class="page-main">
        @Body
    </main>

    <footer class="site-footer">
        <div class="container-wide row-between">
            <span class="cluster" style="gap:1rem;">
                <a class="brand" href=""><BrandLogo /><span>Gialora<span class="brand-mark">.</span></span></a>
                <span>@L["Footer.Tagline"]</span>
            </span>
            <span class="cluster">
                <NavLink href="recipes">@L["Nav.Recipes"]</NavLink>
                <span aria-hidden="true">·</span>
                <NavLink href="blog">@L["Nav.Blog"]</NavLink>
            </span>
        </div>
    </footer>

    <ChatWidget />
    <CookieConsent />
</div>
