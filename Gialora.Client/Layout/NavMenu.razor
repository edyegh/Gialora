@* Gialora.Client/Layout/NavMenu.razor
   Կառուցվածքը ուղիղ հետևում է app structure §2-ի "Website structure"-ին՝
   HOME / DAILY / WEEKLY / BATCH & FREEZE / RECIPES / SHOPPING LIST / BLOG *@
@inject NavigationManager Navigation

<header class="site-header">
    <div class="container-wide site-header-inner">
        <a class="brand" href="">Gialora<span class="brand-mark">.</span></a>

        <button class="nav-toggle" type="button" @onclick="ToggleMenu"
                aria-label="@L["Nav.ToggleNavigation"]" aria-expanded="@(!collapsed)">
            ☰
        </button>

        @* Class, ոչ թե hidden attribute — hidden-ը թաքցնում է ամեն լայնության վրա,
           իսկ մեզ պետք է, որ desktop-ում մենյուն միշտ երևա *@
        <nav class="site-nav @(collapsed ? "is-collapsed" : null)">
            <NavLink href="" Match="NavLinkMatch.All">@L["Nav.Home"]</NavLink>
            <NavLink href="daily">@L["Nav.Daily"]</NavLink>
            <NavLink href="weekly">@L["Nav.Weekly"]</NavLink>
            <NavLink href="batch">@L["Nav.Batch"]</NavLink>
            <NavLink href="recipes">@L["Nav.Recipes"]</NavLink>

            <AuthorizeView>
                <Authorized>
                    <NavLink href="shopping-lists">@L["Nav.ShoppingList"]</NavLink>
                </Authorized>
            </AuthorizeView>

            <NavLink href="blog">@L["Nav.Blog"]</NavLink>

            <span class="site-nav-spacer"></span>

            <AuthorizeView>
                <Authorized Context="auth">
                    <AuthorizeView Roles="Admin" Context="adminAuth">
                        <NavLink href="admin/recipes">@L["Nav.Admin"]</NavLink>
                    </AuthorizeView>
                    <NavLink href="favorites">@L["Nav.Saved"]</NavLink>
                    <NavLink href="family">@L["Nav.MyFamily"]</NavLink>
                    <NavLink href="logout">@L["Nav.SignOut"]</NavLink>
                </Authorized>
                <NotAuthorized>
                    <NavLink href="login">@L["Nav.SignIn"]</NavLink>
                    <NavLink href="register">@L["Nav.CreateAccount"]</NavLink>
                </NotAuthorized>
            </AuthorizeView>

            @* Լեզվի ընտրիչ — արժեքը localStorage-ում է, բոլոր էջերը միանգամից re-render են լինում *@
            <select class="lang-select" aria-label="@L["Nav.Language"]" title="@L["Nav.Language"]"
                    value="@L.Language" @onchange="OnLanguageChanged">
                @foreach (var language in Localizer.Languages)
                {
                    <option value="@language.Code">@language.NativeName</option>
                }
            </select>
        </nav>
    </div>
</header>

@code {
    // Մենյուն միշտ "collapsed" վիճակում ենք պահում. desktop-ում CSS-ը այն
    // ամեն դեպքում ցույց է տալիս, ուստի սա ազդում է միայն նեղ էկրանին։
    private bool collapsed = true;

    protected override void OnInitialized()
    {
        base.OnInitialized(); // լեզվի բաժանորդագրությունը
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void ToggleMenu() => collapsed = !collapsed;

    private Task OnLanguageChanged(ChangeEventArgs e) =>
        L.SetLanguageAsync(e.Value?.ToString() ?? Localizer.DefaultLanguage);

    // Էջ փոխելուց հետո բացված մենյուն պիտի փակվի — հակառակ դեպքում հեռախոսին
    // նոր էջը բացվում է մենյուի տակ թաքնված։
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (collapsed) return;

        collapsed = true;
        StateHasChanged();
    }

    public override void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }
}
