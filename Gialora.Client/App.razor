@* Gialora.Client/App.razor *@
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized Context="authState">
                    @if (authState.User.Identity?.IsAuthenticated == true)
                    {
                        <LayoutView Layout="@typeof(MainLayout)">
                            <p role="alert">@L["App.NotAuthorized"]</p>
                        </LayoutView>
                    }
                    else
                    {
                        @* Navigation-ը render-ի ընթացքում կանչելը սխալ էր (render loop / կիսատ render).
                           RedirectToLogin-ը դա անում է OnInitialized-ում՝ ճիշտ պահին։ *@
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <LayoutView Layout="@typeof(MainLayout)">
                        <p>@L["App.CheckingSession"]</p>
                    </LayoutView>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>@L["App.NotFoundTitle"]</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">@L["App.NotFound"]</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
